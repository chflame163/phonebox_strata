# 服务器（Strata）侧配置 —— 部署到 /usr/local/bin/plugdelay/plug-delay.env（.env 本体不进 git）
# 心跳与关机握手都发往群晖 NAS 的这个地址与端口（共用端口，载荷区分）。

NAS_IP=<nas-ip>             # 群晖 NAS 的局域网地址
HB_PORT=12345               # NAS 上 plug_watcher 监听的 UDP 端口，须与其 LISTEN_PORT 一致
HB_INTERVAL=5               # 心跳间隔（秒）；停发即"这台机器已经不在了"的明确信号
