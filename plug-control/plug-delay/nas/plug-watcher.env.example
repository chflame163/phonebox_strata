# 群晖 NAS 侧 plug_watcher 配置 —— 拷成 plug-watcher.env 再改路径（.env 本体不进 git）
# 判决阈值(秒)。计划关机和异常失联都等满同样的时长再断电，最简单一致。

LISTEN_PORT=12345         # 监听 UDP 端口，须与服务器 HB_PORT 一致
STALE_TIMEOUT=180         # 异常兜底：连续无心跳满 180s → 判定服务器已失联 → 关插座
SHUTDOWN_DELAY=180        # 计划关机：收到 SHUTDOWN 握手后仍等满 180s 再关（绝不高估提前断）
REBOOT_GRACE=90           # NAS 自身重启后前 90s 不下发关闭，等心跳刷新，防重启空档误判
FIRE_RETRY=30             # 关插座命令失败后每隔 30s 重试
HB_ALIVE_LOG=30           # 心跳存活日志间隔（秒），生产留着好判断"到底是没心跳还是没到"

# 触发时实际执行的"关插座"命令（用 shell 执行，可含 $(...) ）。
# 首次部署先 dry-run 验时机，确认无误再换成下面这条真命令：
#   路径里的 <nas-user> 换成你在群晖上的家目录用户名（本机现状是 cc，家目录在 /volume2 不是 /volume1）
PLUG_OFF_CMD=/volume2/homes/<nas-user>/pdvenv/bin/python3 -I /volume2/homes/<nas-user>/plug-delay/nas/nas_off.py

# 凭据不在本文件里：nas_off.py 从同目录 plug-secret.env（或环境变量 PB_PLUG_IP/PB_PLUG_TOKEN）读，
# 所以换插座 token 只改一处，watcher 不用动、也不用重启。
#
# 不想用 venv 脚本、直接走 miiocli 的等价写法（两选一）：
# PLUG_OFF_CMD=miiocli plugpower --ip <plug-ip> --token <plug-token> set_power_on off
# 若上面对 newer miot 型号不生效，用通用写法（本插座实测 siid2/piid1 读写都 code:0）：
# PLUG_OFF_CMD=miiocli genericmiot --ip <plug-ip> --token <plug-token> set --siid 2 --piid 1 --value false
#
# 手动送电回来（把上面脚本的 --on 加上，或米家 App 手动开）：
#   .../nas_off.py --on
