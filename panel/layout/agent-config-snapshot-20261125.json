        {
          "id": "html",
          "type": "html",
          "x": 8,
          "y": 0,
          "w": 4,
          "h": 2,
          "options": {
            "html": "<!-- Strata \"Model state\" — PhoneBox Custom HTML widget (6x2).\n     1:1 移植自 Strata serve/web：index.html 的 .state-card + components.css 的 .st-badge/.st-progress\n     + app.css 的 .badges opacity 规则 + app.js renderMonitor() 的 label/detail/pct 逻辑。\n     卡片外框（背景/边框/圆角）由 PhoneBox 的 .w-html.card 提供，这里只画内容。\n     数据：push key `strata_state`，payload 见 pb_strata_push.py 注释。\n     v2 (2026-11-25 维护者五项改版)：① 去 \"Model state\" 标题；② 徽章互斥——DOM 里只留当前态一个\n     （Queued 时文本带队列数 \"Queued N\"），不再六坑位半透明并排；③ 工作文字(label)独立一行、\n     nowrap+ellipsis，绝不被右侧数值挤成两行而顶得进度条上下跳；④ 灰色数值(detail)挪到 label\n     正下方同左对齐；⑤ 进度条原样。fit() 同步简化：head=单徽章恒为单行，无数据时徽章整个移除。\n     v3 (2026-11-25 维护者追加)：Queued 是**独立队列信号**、不是引擎状态机的成员（实测它几乎从不\n     lit——lit 判定 s===lit||s===state 里 queued 两路都撞不上），v2 把它卷进互斥单徽章后基本不显示。\n     现拆成右侧常驻等位指示灯：margin-left:auto 钉死右端（左侧有没有状态徽章都不动）、永不移除；\n     有队列=warn 亮起+文本 \"Queued N\"，队列为空=中性淡显 \"Queued\"。互斥区从此只管\n     idle/unloaded/reading/generating/error 五个真状态。 -->\n<style>\n:root{\n  /* Strata dark-theme tokens（tokens.css [data-theme=dark] 原值；中性色改成 PhoneBox 卡上的 rgba 等效） */\n  --ms-info:#3aa9ff;      --ms-info-tint:rgba(58,169,255,.12);   --ms-info-text:#7cc4ff;\n  --ms-accent:#34d399;    --ms-accent-tint:rgba(52,211,153,.12); --ms-accent-text:#4ade80;\n  --ms-warn:#f5b53d;      --ms-warn-tint:rgba(245,181,61,.12);   --ms-warn-text:#f8c96a;\n  --ms-danger:#ff5a6e;    --ms-danger-tint:rgba(255,90,110,.12); --ms-danger-text:#ff8a98;\n  --ms-ink:#eef1f3;       --ms-ink-muted:#8e979f;\n  --ms-surface-2:rgba(255,255,255,.07);   /* = --st-surface-2 */\n  --ms-line:rgba(255,255,255,.10);        /* = --st-line    */\n  --ms-line-soft:rgba(255,255,255,.06);   /* = --st-line-soft */\n  --ms-ease:cubic-bezier(.2,.7,.2,1);\n}\n.ms{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;gap:.75em;\n    padding:1.1em 1.4em;box-sizing:border-box;overflow:hidden;\n    color:var(--ms-ink);font-size:15px;font-variant-numeric:tabular-nums;\n    font-synthesis:none;-webkit-font-smoothing:antialiased}\n.ms>*,.ms{min-width:0}\n.ms__head{display:flex;align-items:center;gap:.75em;flex-wrap:wrap;flex:none}\n.ms__title{font-weight:700;font-size:1.2em;line-height:1.15;letter-spacing:.005em;color:var(--ms-ink);white-space:nowrap}\n.ms__badges{display:flex;gap:.5em;flex-wrap:wrap;min-width:0}   /* v2：只剩当前态一个徽章，恒单行 */\n.ms__badge{display:inline-flex;align-items:center;gap:.5em;height:2em;padding:0 .83em;flex:none;\n  border-radius:9999px;font-size:.95em;font-weight:700;line-height:1;white-space:nowrap;\n  background:var(--ms-surface-2);color:var(--ms-ink-muted);border:1px solid var(--ms-line);\n  opacity:.38;transition:opacity 160ms var(--ms-ease)}\n.ms__badge::before{content:\"\";width:.62em;height:.62em;border-radius:50%;background:currentColor;flex:none}\n.ms__badge[data-s=\"reading\"]{background:var(--ms-info-tint);color:var(--ms-info-text);border-color:transparent}\n.ms__badge[data-s=\"generating\"]{background:var(--ms-accent-tint);color:var(--ms-accent-text);border-color:transparent}\n.ms__badge[data-s=\"error\"]{background:var(--ms-danger-tint);color:var(--ms-danger-text);border-color:transparent}\n.ms__badge.on{opacity:1}\n/* v3：Queued = 右侧常驻队列灯——margin-left:auto 钉右端(与左侧徽章区解耦)、永不移除；\n   有队列 warn 亮+数字，空闲中性淡显。它不是引擎状态成员，故不吃 data-s 状态配色。 */\n.ms__qbadge{margin-left:auto;flex:none}\n.ms__qbadge.on{background:var(--ms-warn-tint);color:var(--ms-warn-text);border-color:transparent;opacity:1}\n/* v2③④：label 独立一行 nowrap+ellipsis（撑不下截断，永不换行顶跳动进度条）；detail 下一行左对齐 */\n.ms__stack{display:flex;flex-direction:column;gap:.15em;flex:none;min-width:0}\n.ms__label{font-size:1em;font-weight:500;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}\n.ms__detail{color:var(--ms-ink-muted);font-weight:400;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}\n.ms__prog{position:relative;height:.62em;border-radius:9999px;background:var(--ms-surface-2);border:1px solid var(--ms-line-soft);overflow:hidden;flex:none}\n.ms__bar{height:100%;border-radius:inherit;background:var(--ms-accent);transition:width 160ms var(--ms-ease)}\n.ms__prog[data-tone=\"info\"] .ms__bar{background:var(--ms-info)}\n/* 没有可靠分母时的“进行中”显示：整条 32% 淡底 + 一块扫光（Strata React 版 Monitor 的 indeterminate 思路） */\n.ms__bar--indet{width:100% !important;opacity:.32}   /* 元素上有条内联 width:0%，这里必须 !important 才能铺出淡底 */\n.ms__prog--indet::after{content:\"\";position:absolute;top:0;bottom:0;left:0;width:24%;border-radius:9999px;\n  background:var(--ms-accent);animation:ms-sweep 1.5s var(--ms-ease) infinite alternate}\n.ms__prog[data-tone=\"info\"].ms__prog--indet::after{background:var(--ms-info)}\n@keyframes ms-sweep{0%{transform:translateX(-30%)}100%{transform:translateX(330%)}}\n@media (prefers-reduced-motion:reduce){.ms__prog--indet::after{animation:none;left:auto;right:0;width:38%}}\n.ms__prog[data-tone=\"warn\"] .ms__bar{background:var(--ms-warn)}\n.ms__prog[data-tone=\"danger\"] .ms__bar{background:var(--ms-danger)}\n</style>\n\n<div class=\"ms\" id=\"ms\">\n  <div class=\"ms__head\" id=\"ms-head\">\n    <!-- v2①：无标题；v2②：互斥状态徽章由 JS 动态生成，任意时刻至多一个（idle/unloaded/reading/generating/error） -->\n    <span class=\"ms__badges\" id=\"ms-badges\"></span>\n    <!-- v3：常驻队列灯——JS 只改它的 on 态与文本，元素本身永不移除；margin-left:auto 钉死右端 -->\n    <span class=\"ms__badge ms__qbadge\" id=\"ms-qbadge\">Queued</span>\n  </div>\n  <div class=\"ms__stack\"><span class=\"ms__label\" id=\"ms-label\">Waiting for a request</span><span class=\"ms__detail\" id=\"ms-detail\">–</span></div>\n  <div class=\"ms__prog\" id=\"ms-prog\"><div class=\"ms__bar\" id=\"ms-bar\" style=\"width:0%\"></div></div>\n</div>\n\n<script>\n(function () {\n  var KEY = \"strata_state\";\n  var root = document.getElementById(\"ms\"),\n      head = document.getElementById(\"ms-head\"),\n      badges = document.getElementById(\"ms-badges\"),\n      qbadge = document.getElementById(\"ms-qbadge\"),\n      labelEl = document.getElementById(\"ms-label\"),\n      detailEl = document.getElementById(\"ms-detail\"),\n      progEl = document.getElementById(\"ms-prog\"),\n      barEl = document.getElementById(\"ms-bar\");\n\n  // app.js 第 9 行的 fmt：空值显示 en dash，数字千分位\n  function fmt(n, d) {\n    d = d || 0;\n    if (n === null || n === undefined || n === \"\" || Number.isNaN(+n)) return \"–\";\n    return Number(n).toLocaleString(\"en-US\", { maximumFractionDigits: d, minimumFractionDigits: d });\n  }\n\n  var lastData = null;\n\n  // v2②+v3：互斥徽章只管引擎真状态——DOM 里只渲染当前态一个；Queued 已从互斥区拆出，\n  // 归右侧常驻队列灯管（见 setQueue）。无数据(state=null)→移除徽章、头部塌陷。\n  var BADGE_TXT = { idle: \"Idle\", unloaded: \"Unloaded\", reading: \"Reading\",\n                    generating: \"Generating\", error: \"Error\" };\n  function setBadge(state) {\n    if (!state || !BADGE_TXT[state]) { badges.replaceChildren(); return; }\n    var b = document.createElement(\"span\");\n    b.className = \"ms__badge on\";                 // 只有一个，恒亮（.on 规则保留以兼容样式）\n    b.setAttribute(\"data-s\", state);\n    b.textContent = BADGE_TXT[state];\n    badges.replaceChildren(b);\n  }\n\n  // v3：右侧常驻队列灯——元素永不移除、位置被 margin-left:auto 钉死；有队列 warn 亮+\"Queued N\"，\n  // 队列为空（或无数据）中性淡显 \"Queued\"。\n  function setQueue(qn) {\n    var on = qn > 0;\n    qbadge.classList.toggle(\"on\", on);\n    qbadge.textContent = on ? \"Queued \" + qn : \"Queued\";\n  }\n\n  function render(item) {\n    var d = item && typeof item === \"object\" && \"data\" in item ? item.data : item;\n    if (d && typeof d === \"object\") lastData = d;\n    if (!d || typeof d !== \"object\") {          // 没有数据（ttl 过期 / 引擎没起）：无徽章、队列灯熄灭、label 回等待态\n      setBadge(null);\n      setQueue(0);\n      paint(null, null, \"\", 0, null);\n      return;\n    }\n    var state = d.state || d.raw_state || null;\n    var qn = +d.queued > 0 ? Math.round(+d.queued) : 0;\n    setBadge(state);                            // v3：互斥徽章=真状态，不再被 queued 劫持\n    setQueue(qn);\n\n    var label = \"Waiting for a request\", detail = \"\", pct = 0, tone = null, indet = false;\n    if (state === \"reading\") {\n      label = \"Reading prompt\"; tone = \"info\";\n      if (+d.prompt_total) {                     // 引擎原样：read / total tokens · N%\n        pct = (100 * +d.prompt_read) / +d.prompt_total;\n        detail = fmt(d.prompt_read) + \" / \" + fmt(d.prompt_total) + \" tokens · \" + fmt(pct) + \"%\";\n      } else {                                   // prompt 不足一个 prefill chunk → 引擎也不报进度\n        detail = fmt(d.prompt_tokens) + \" tokens\"; indet = true;\n      }\n    } else if (state === \"generating\") {\n      label = d.phase ? String(d.phase).charAt(0).toUpperCase() + String(d.phase).slice(1) : \"Generating\";\n      detail = fmt(d.generated) + \" tokens · \" + fmt(d.tok_s, 1) + \" tok/s\";\n      var est = +d.out_est || 0, cap = +d.max_tokens || 0;   // 分母见下面的优先级\n      if (est > 0) pct = Math.min(100, (100 * +d.generated) / est);        // ① 最近请求输出中位数（面板才会真的走）\n      else if (cap > 0 && cap <= 1024) pct = Math.min(100, (100 * +d.generated) / cap);  // ② 客户端给了小上限=真上限\n      else indet = true;                                                    // ③ 没得估 → 扫动\n    } else if (state === \"unloaded\") {\n      label = \"Unloaded\"; detail = \"Load brings it back. A message does too.\";\n    } else if (d.last_detail) {\n      detail = String(d.last_detail);            // idle：引擎的 \"last: N tokens at X tok/s\"\n    }\n    paint(state, label, detail, pct, tone, indet);\n  }\n\n  function paint(state, label, detail, pct, tone, indet) {\n    labelEl.textContent = label || \"Waiting for a request\";\n    detailEl.textContent = detail || \"–\";\n    if (tone) progEl.setAttribute(\"data-tone\", tone); else progEl.removeAttribute(\"data-tone\");\n    var p = +pct; if (!isFinite(p) || p < 0) p = 0; if (p > 100) p = 100;\n    barEl.classList.toggle(\"ms__bar--indet\", !!indet);   // 无分母时：淡底+扫光，别停在 0% 看着像坏了\n    progEl.classList.toggle(\"ms__prog--indet\", !!indet);\n    if (!indet) barEl.style.width = p + \"%\";\n    fit();\n  }\n\n  // v2：徽章只剩一个、label/detail 各自 nowrap，六徽章时代那套“找一行放得下的字号”的搜索已多余——\n  // 简化为从大到小找不溢出的最大字号；head 恒含常驻队列灯故恒有高度。\n  var hi = 17, lo = 7, cache = \"\";\n  function ok(f, tight) {\n    root.style.fontSize = f + \"px\";\n    root.style.gap = tight ? \"0.45em\" : \"\";\n    return root.scrollHeight <= root.clientHeight + 1;\n  }\n  function singleLine() {\n    // v3：head 里常驻队列灯——参照高度取「首个徽章或队列灯」的较大者，恒有值不再退化为 0\n    var ref = badges.firstElementChild || qbadge;\n    var b = ref.getBoundingClientRect().height;\n    return head.getBoundingClientRect().height <= b * 1.6 + 1;\n  }\n  function fit() {\n    // v3：队列灯数字位数(0/1/2/3+位)会改变 head 单行所需字号，cache key 带上其文本长度\n    var key = root.clientWidth + \"x\" + root.clientHeight + \"|\" + badges.children.length + \"|\" + qbadge.textContent.length;\n    if (key === cache && root.scrollHeight <= root.clientHeight + 1) { return; }   // 卡片/徽章数没变就不重排\n    cache = key;\n    var f, FS_MIN_SINGLE = 11;   // 只有单行还能保持 11px 以上才追求原图那种一行排版\n    for (f = hi; f >= Math.max(lo, FS_MIN_SINGLE); f -= 0.5) { if (ok(f, false) && singleLine()) { root.dataset.fs = f; return; } }\n    for (var tight = 0; tight < 2; tight++) {\n      for (f = hi; f >= lo; f -= 0.5) { if (ok(f, tight === 1)) { root.dataset.fs = f; return; } }\n    }\n    ok(lo, true); root.dataset.fs = lo;\n  }\n\n  root.__msRender = render;                              // 离线验证钩子（宿主可直接喂一条 push 数据）\n\n  if (window.phonebox && window.phonebox.on) {           // 真机：PhoneBox 沙箱\n    window.phonebox.on(\"push\", function (items) { render(items && items[KEY]); });\n  } else {                                               // 预览/自测：模拟宿主 postMessage\n    window.addEventListener(\"message\", function (e) {\n      var m = e.data;\n      if (m && m.phonebox === \"data\" && m.kind === \"push\") render(m.value && m.value[KEY]);\n    });\n  }\n  window.addEventListener(\"resize\", fit);\n  fit();\n})();\n</script>\n",
            "transparent": false
          }
        },
        {
          "id": "push-4",
          "type": "push",
          "x": 6,
